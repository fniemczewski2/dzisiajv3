# .env.example – skopiuj do .env.local i uzupełnij. Opis każdej zmiennej: README → „Zmienne środowiskowe”.
# Zmienne NEXT_PUBLIC_* trafiają do kodu w przeglądarce – nie wpisuj tam sekretów.

# --- Supabase (wymagane) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Aplikacja ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Szyfrowanie tokenów integracji (32 bajty, base64) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# 1 = odrzucaj niezaszyfrowane tokeny (po uruchomieniu scripts/encrypt-legacy-tokens.mjs)
REJECT_PLAINTEXT_TOKENS=

# --- Integracje (opcjonalne) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TMDB_API_KEY=
PLK_API_KEY=

# --- Zadania cykliczne (cron) ---
CRON_SECRET=

# --- Powiadomienia push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 1 = rejestruj service worker także w `next dev` (domyślnie tylko w produkcji)
NEXT_PUBLIC_SW_DEV=

# --- Limity zapytań (produkcja; lokalnie można pominąć) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CSP: 1 = tylko raportuj naruszenia (diagnoza) ---
CSP_REPORT_ONLY=
